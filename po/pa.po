#: prefs.js
msgid "Smart Top Bar"
msgstr "ਸਮਾਰਟ ਉੱਪਰੀ ਪੱਟੀ"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "ਦਿਖਾਉਣ ਲਈ ਉੱਪਰਲੇ ਕਿਨਾਰੇ ਉੱਤੇ ਦੋ ਵਾਰ ਖੱਬੇ-ਸੱਜੇ ਹਿਲਾਓ"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "ਵੱਧ ਤੋਂ ਵੱਧ ਜਾਂ ਟਾਈਲ ਕੀਤੀਆਂ ਵਿੰਡੋਆਂ ਵਿੱਚ ਲੁਕਾਓ। ਅਸਲੀ ਪੂਰੀ ਸਕਰੀਨ ਵਿੱਚ ਕਦੇ ਨਾ ਦਿਖਾਓ।"

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "ਸੂਚਕ ਨੂੰ ਮੁੱਖ ਸਕਰੀਨ ਦੇ ਉੱਪਰਲੇ ਕਿਨਾਰੇ ਤੋਂ 3 ਪਿਕਸਲ ਅੰਦਰ ਰੱਖ ਕੇ ਦੋ ਵਾਰ ਖੱਬੇ-ਸੱਜੇ ਹਿਲਾਓ।"

#: prefs.js
msgid "Stroke distance"
msgstr "ਹਰ ਹਿਲਜੁਲ ਦੀ ਦੂਰੀ"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "ਲਾਜ਼ੀਕਲ ਪਿਕਸਲ; ਵੱਡੀ ਗਿਣਤੀ ਅਚਾਨਕ ਦਿਖਣ ਨੂੰ ਘਟਾਉਂਦੀ ਹੈ।"

#: prefs.js
msgid "Gesture time limit"
msgstr "ਇਸ਼ਾਰੇ ਦੀ ਸਮਾਂ ਸੀਮਾ"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "ਚਾਰ ਵਾਰੀ ਬਦਲਵੀਂ ਹਿਲਜੁਲ ਪੂਰੀ ਕਰਨ ਲਈ ਮਿਲੀਸਕਿੰਟ।"

#: prefs.js
msgid "Hide delay"
msgstr "ਲੁਕਾਉਣ ਵਿੱਚ ਦੇਰੀ"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "ਹਟਣ ਤੋਂ ਬਾਅਦ ਮਿਲੀਸਕਿੰਟ; ਖੁੱਲ੍ਹੇ ਮੀਨੂ ਅਤੇ ਕੀਬੋਰਡ ਵਰਤੋਂ ਦੌਰਾਨ ਪੱਟੀ ਦਿਖਦੀ ਰਹਿੰਦੀ ਹੈ।"

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "ਸ਼ਾਰਟਕੱਟ: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "ਆਰਜ਼ੀ ਤੌਰ ਉੱਤੇ ਦਿਖਾਓ ਜਾਂ ਲੁਕਾਓ। ਅਸਲੀ ਪੂਰੀ ਸਕਰੀਨ ਵਿੱਚ ਬੰਦ; ਝਲਕ ਲਈ Super ਦਬਾਓ।"
