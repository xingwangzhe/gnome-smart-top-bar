#: prefs.js
msgid "Smart Top Bar"
msgstr "Thanh trên thông minh"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Lắc trái phải hai lần ở cạnh trên để hiện"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Ẩn khi cửa sổ phóng to hoặc xếp ô. Không hiện trong chế độ toàn màn hình thực sự."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "Giữ con trỏ trong phạm vi 3 điểm ảnh ở cạnh trên màn hình chính và di chuyển trái phải hai lần."

#: prefs.js
msgid "Stroke distance"
msgstr "Khoảng cách mỗi lượt"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Điểm ảnh lôgic; giá trị lớn hơn giúp tránh hiện ngoài ý muốn."

#: prefs.js
msgid "Gesture time limit"
msgstr "Giới hạn thời gian cử chỉ"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Mili giây để hoàn thành cả bốn lượt luân phiên."

#: prefs.js
msgid "Hide delay"
msgstr "Độ trễ ẩn"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Mili giây sau khi rời đi; menu đang mở và điều hướng bàn phím giữ thanh hiển thị."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Phím tắt: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Tạm hiện hoặc ẩn. Vô hiệu trong toàn màn hình thực sự; nhấn Super để mở tổng quan."
