#: prefs.js
msgid "Smart Top Bar"
msgstr "Chytrá horní lišta"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Pro zobrazení pohněte u horního okraje dvakrát tam a zpět"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Skrýt při maximalizovaných nebo dlaždicových oknech. Nikdy nezobrazovat ve skutečném režimu celé obrazovky."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "Držte ukazatel do 3 pixelů od horního okraje hlavní obrazovky a dvakrát jím pohněte doleva a doprava."

#: prefs.js
msgid "Stroke distance"
msgstr "Délka pohybu"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Logické pixely; vyšší hodnoty omezují nechtěné zobrazení."

#: prefs.js
msgid "Gesture time limit"
msgstr "Časový limit gesta"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Milisekundy na dokončení všech čtyř střídavých pohybů."

#: prefs.js
msgid "Hide delay"
msgstr "Prodleva skrytí"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Milisekundy po opuštění; otevřené nabídky a ovládání klávesnicí udržují lištu viditelnou."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Zkratka: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Dočasně zobrazit nebo skrýt. Ve skutečném režimu celé obrazovky vypnuto; Super otevře přehled."
