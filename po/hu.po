#: prefs.js
msgid "Smart Top Bar"
msgstr "Intelligens felső sáv"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Megjelenítéshez mozgassa kétszer oda-vissza a felső szélen"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Elrejtés teljes méretű vagy csempézett ablakoknál. Valódi teljes képernyőn soha nem jelenik meg."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "Tartsa a mutatót a főképernyő felső szélétől 3 képponton belül, és mozgassa kétszer balra-jobbra."

#: prefs.js
msgid "Stroke distance"
msgstr "Mozgásonkénti távolság"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Logikai képpont; a nagyobb érték csökkenti a véletlen megjelenést."

#: prefs.js
msgid "Gesture time limit"
msgstr "A gesztus időkorlátja"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Ezredmásodperc mind a négy váltakozó mozgás befejezéséhez."

#: prefs.js
msgid "Hide delay"
msgstr "Elrejtési késleltetés"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Ezredmásodperc az eltávolodás után; nyitott menük és billentyűzetes navigáció közben a sáv látható marad."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Gyorsbillentyű: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Ideiglenes megjelenítés vagy elrejtés. Valódi teljes képernyőn letiltva; a Super megnyitja az áttekintést."
