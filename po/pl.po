#: prefs.js
msgid "Smart Top Bar"
msgstr "Inteligentny górny pasek"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Porusz dwa razy tam i z powrotem przy górnej krawędzi"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Ukrywaj przy zmaksymalizowanych lub kafelkowanych oknach. Nigdy nie pokazuj w rzeczywistym pełnym ekranie."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "Trzymaj wskaźnik do 3 pikseli od górnej krawędzi głównego ekranu i porusz nim w lewo i prawo dwa razy."

#: prefs.js
msgid "Stroke distance"
msgstr "Długość ruchu"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Piksele logiczne; większa wartość ogranicza przypadkowe pokazywanie."

#: prefs.js
msgid "Gesture time limit"
msgstr "Limit czasu gestu"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Milisekundy na wykonanie wszystkich czterech naprzemiennych ruchów."

#: prefs.js
msgid "Hide delay"
msgstr "Opóźnienie ukrywania"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Milisekundy po odejściu; otwarte menu i nawigacja klawiaturą utrzymują pasek widoczny."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Skrót: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Tymczasowo pokaż lub ukryj. Wyłączone w rzeczywistym pełnym ekranie; Super otwiera podgląd."
