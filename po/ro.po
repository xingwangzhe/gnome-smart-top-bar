#: prefs.js
msgid "Smart Top Bar"
msgstr "Bară de sus inteligentă"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Mișcați de două ori înainte și înapoi la marginea de sus"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Ascunde la ferestre maximizate sau alăturate. Nu afișează niciodată în ecran complet real."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "Țineți indicatorul la cel mult 3 pixeli de marginea de sus a ecranului principal și mișcați-l de două ori stânga-dreapta."

#: prefs.js
msgid "Stroke distance"
msgstr "Distanța fiecărei mișcări"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Pixeli logici; valorile mari reduc afișările accidentale."

#: prefs.js
msgid "Gesture time limit"
msgstr "Limita de timp a gestului"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Milisecunde pentru toate cele patru mișcări alternative."

#: prefs.js
msgid "Hide delay"
msgstr "Întârziere la ascundere"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Milisecunde după plecare; meniurile deschise și navigarea cu tastatura păstrează bara vizibilă."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Scurtătură: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Afișează sau ascunde temporar. Dezactivată în ecran complet real; Super deschide prezentarea generală."
