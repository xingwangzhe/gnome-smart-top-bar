#: prefs.js
msgid "Smart Top Bar"
msgstr "Akıllı üst çubuk"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Göstermek için üst kenarda iki kez sağa sola sallayın"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Büyütülmüş veya döşenmiş pencerelerde gizlenir. Gerçek tam ekranda asla gösterilmez."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "İşaretçiyi ana ekranın üst kenarındaki 3 piksel içinde tutup iki kez sağa sola hareket ettirin."

#: prefs.js
msgid "Stroke distance"
msgstr "Hareket mesafesi"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Mantıksal piksel; büyük değerler yanlışlıkla görünmeyi azaltır."

#: prefs.js
msgid "Gesture time limit"
msgstr "Hareket süresi sınırı"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Dört dönüşümlü hareketi tamamlamak için milisaniye."

#: prefs.js
msgid "Hide delay"
msgstr "Gizleme gecikmesi"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Ayrıldıktan sonraki milisaniye; açık menüler ve klavyeyle gezinme çubuğu görünür tutar."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Kısayol: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Geçici olarak gösterir veya gizler. Gerçek tam ekranda devre dışıdır; genel görünüm için Super tuşuna basın."
