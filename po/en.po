#: prefs.js
msgid "Smart Top Bar"
msgstr "Smart Top Bar"

#: prefs.js
msgid "Shake twice at the top edge to reveal"
msgstr "Shake twice at the top edge to reveal"

#: prefs.js
msgid "Hide when maximized or tiled. Never reveal in true fullscreen."
msgstr "Hide when maximized or tiled. Never reveal in true fullscreen."

#: prefs.js
msgid "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."
msgstr "Keep the pointer within 3 pixels of the primary screen’s top edge and move left and right twice."

#: prefs.js
msgid "Stroke distance"
msgstr "Stroke distance"

#: prefs.js
msgid "Logical pixels; larger values reduce accidental reveals."
msgstr "Logical pixels; larger values reduce accidental reveals."

#: prefs.js
msgid "Gesture time limit"
msgstr "Gesture time limit"

#: prefs.js
msgid "Milliseconds to complete all four alternating strokes."
msgstr "Milliseconds to complete all four alternating strokes."

#: prefs.js
msgid "Hide delay"
msgstr "Hide delay"

#: prefs.js
msgid "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."
msgstr "Milliseconds after leaving; open menus and keyboard navigation keep the bar visible."

#: prefs.js
msgid "Shortcut: Super + Ctrl + B"
msgstr "Shortcut: Super + Ctrl + B"

#: prefs.js
msgid "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
msgstr "Reveal or hide temporarily. Disabled in true fullscreen; press Super to use the overview."
