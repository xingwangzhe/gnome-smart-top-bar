<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="smart-top-bar">
  <schema id="org.gnome.shell.extensions.smart-top-bar" path="/org/gnome/shell/extensions/smart-top-bar/">
    <key name="gesture-distance" type="i"><default>36</default><range min="20" max="120"/><summary>Stroke distance</summary></key>
    <key name="gesture-timeout" type="i"><default>1600</default><range min="800" max="4000"/><summary>Gesture time limit</summary></key>
    <key name="hide-delay" type="i"><default>650</default><range min="200" max="2500"/><summary>Hide delay</summary></key>
    <key name="toggle-bar" type="as"><default>['&lt;Super&gt;&lt;Control&gt;b']</default><summary>Shortcut: Super + Ctrl + B</summary></key>
  </schema>
</schemalist>
